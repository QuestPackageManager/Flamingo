{
  "configVersion": "2.0.0",
  "id": "flamingo",
  "version": "1.3.1",
  "additionalData": {
    "url": "https://github.com/QuestPackageManager/Flamingo"
  },
  "workspace": {
    "scripts": {
      "build": [
        "pwsh ./build.ps1",
        "cmake -E make_directory extern/build/build",
        "cmake -E copy build/libflamingo.so extern/build/build/libflamingo.so"
      ],
      "build-android-test": [
        "pwsh ./build-android-test.ps1"
      ]
    },
    "ndk": "^29.0.14206865",
    "outBinaries": [
      "build/libflamingo.so"
    ],
    "toolchainOut": null,
    "cmake": false
  },
  "qmod": {
    "id": "flamingo",
    "template": "mod.template.json",
    "output": "flamingo.qmod",
    "searchDirs": [
      "./build"
    ],
    "includeFiles": []
  },
  "dependencies": {
    "fmt": {
      "versionRange": "^12.2.1",
      "qmod": "none"
    }
  },
  "devDependencies": {
    "capstone": {
      "versionRange": "^5.0.9",
      "qmod": "none"
    },
    "scotland2": {
      "versionRange": "^0.1.6",
      "qmod": "none"
    }
  },
  "dependenciesDirectory": "extern",
  "sharedDirectory": "shared",
  "compileOptions": {
    "includePaths": [""]
  }
}
